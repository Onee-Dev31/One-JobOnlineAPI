<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\JobOnlineAPI.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" />
          <environmentVariable name="TEMP" value="C:\inetpub\temp\JobOnlineAPI" />
          <environmentVariable name="TMP" value="C:\inetpub\temp\JobOnlineAPI" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
